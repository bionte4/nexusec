# Secrets — copy to `.env` and replace all CHANGE_ME values before deploy.
# NEVER commit `.env` (see .gitignore). Containers load secrets via env_file / compose interpolation.

# --- Application ---
APP_NAME=NexuSec
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexusec
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=nexusec
# Local (non-compose) default; compose overrides host to `postgres`
DATABASE_URL=postgresql+asyncpg://nexusec:CHANGE_ME_strong_postgres_password@localhost:5432/nexusec

# --- Redis (requirepass) ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password@localhost:6379/2

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Integrations (Prompt 7) — leave disabled unless configured ---
WEBHOOK_ENABLED=false
WEBHOOK_PROVIDER=slack
WEBHOOK_URLS=
WEBHOOK_MIN_SEVERITY=high

TICKET_ENABLED=false
TICKET_PROVIDER=jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Bug
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident

SIEM_ENABLED=false
SIEM_FORMAT=json
SIEM_WEBHOOK_URL=
SIEM_HEC_TOKEN=
