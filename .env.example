# Secrets — copy to `.env` and replace all CHANGE_ME values before deploy.
# NEVER commit `.env` (see .gitignore). Containers load secrets via env_file / compose interpolation.

# --- Application ---
APP_NAME=NexuSec
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexusec
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=nexusec
# Local (non-compose) default; compose overrides host to `postgres`
DATABASE_URL=postgresql+asyncpg://nexusec:CHANGE_ME_strong_postgres_password@localhost:5432/nexusec

# --- Redis (requirepass) ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password@localhost:6379/2

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Integrations (Prompt 7) — leave disabled unless configured ---
WEBHOOK_ENABLED=false
WEBHOOK_PROVIDER=slack
WEBHOOK_URLS=
WEBHOOK_MIN_SEVERITY=high

TICKET_ENABLED=false
TICKET_PROVIDER=jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Bug
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_TABLE=incident

SIEM_ENABLED=false
SIEM_FORMAT=json
SIEM_WEBHOOK_URL=
SIEM_HEC_TOKEN=

# --- Threat intelligence (Prompt 11) ---
KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_KEY=
NVD_RATE_LIMIT_SLEEP=0.65
THREAT_INTEL_SYNC_ENABLED=true
THREAT_INTEL_KEV_INTERVAL_HOURS=6
THREAT_INTEL_ENRICH_INTERVAL_HOURS=1
EPSS_ENABLED=true
EPSS_API_URL=https://api.first.org/data/v1/epss
EPSS_TIMEOUT_SECONDS=20

# --- Remediation SLA (days) ---
SLA_DAYS_CRITICAL=7
SLA_DAYS_HIGH=14
SLA_DAYS_MEDIUM=30
SLA_DAYS_LOW=90
SLA_DAYS_INFO=180

# --- Auto-retest when status → remediated ---
AUTO_RETEST_ENABLED=true
AUTO_RETEST_ENGINE=nuclei
AUTO_RETEST_SCAN_TYPE=va

# --- Observability (Prompt 13) ---
HEALTH_CHECK_TIMEOUT_SECONDS=3
DOCKER_SOCKET_PATH=/var/run/docker.sock
WORKER_HANG_THRESHOLD_MINUTES=45
PROMETHEUS_METRICS_ENABLED=true

# --- AI remediation (Prompt 14 / 17) — OpenAI-compatible (Groq, OpenRouter, OpenAI) ---
AI_REMEDIATION_ENABLED=true
AI_REMEDIATION_PROVIDER=auto
AI_REMEDIATION_FALLBACK_MOCK=true
AI_REMEDIATION_TIMEOUT_SECONDS=60
# Preferred credentials for remediation (Prompt 17)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Examples:
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=gpt-4o-mini
AI_FORCE_JSON_RESPONSE=false

# --- AI false-positive analysis (Prompt 15) ---
AI_FP_ENABLED=true
AI_FP_PROVIDER=auto
AI_FP_FALLBACK_MOCK=true
AI_FP_TIMEOUT_SECONDS=60

# --- AI SOC ChatOps / RAG (Prompt 16) ---
AI_SOC_CHAT_ENABLED=true
AI_SOC_CHAT_PROVIDER=auto
AI_SOC_CHAT_FALLBACK_MOCK=true
AI_SOC_CHAT_TIMEOUT_SECONDS=90
AI_SOC_CHAT_RETRIEVAL_LIMIT=25
AI_SOC_CHAT_MAX_SOURCES=40
AI_SOC_CHAT_MAX_QUERY_CHARS=4000

# Legacy aliases (still used by FP analysis + ChatOps; remediation prefers AI_* above)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest
